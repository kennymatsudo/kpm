    "@parcel/watcher": "^2.5.6",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "better-sqlite3": "12.11.1",
    "diff": "9.0.0",
    "dompurify": "^3.4.11",
    "elkjs": "^0.11.1",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "jira.js": "5.4.0",
    "keytar": "7.9.0",
    "mermaid": "^11.16.0",
    "node-pty": "1.1.0",
    "which": "6.0.1",
    "zod": "4.4.3"
  },
  "overrides": {
