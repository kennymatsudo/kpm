{
  "name": "kpm",
  "productName": "KPM - Planning Workbench",
  "version": "0.10.16",
  "private": true,
  "description": "A codebase-aware planning workbench for developers",
  "main": "dist/main/index.js",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "package": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "postinstall": "install-electron && electron-builder install-app-deps && node scripts/patch-electron-icon.js && node scripts/patch-electron-plist.js",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "electron",
    "planning",
    "developer-tools"
  ],
  "author": {
    "name": "Kenny Matsudo",
    "email": "kennymatsudo@live.com"
  },
  "license": "MIT",
