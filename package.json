    "electron-devtools-installer": "4.0.0",
    "electron-playwright-helpers": "2.1.0",
    "electron-vite": "6.0.0-beta.1",
    "eslint": "10.6.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "framer-motion": "12.42.2",
