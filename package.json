    "@xterm/xterm": "6.0.0",
    "better-sqlite3": "13.0.3",
    "diff": "9.0.0",
    "dompurify": "^3.4.16",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "jira.js": "6.2.0",
    "keytar": "7.9.0",
    "mermaid": "^11.17.2",
    "node-pty": "1.1.0",
